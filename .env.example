# Database
# Docker Compose maps Postgres to host port 5434 (not 5432) to avoid conflicts
# with a native/system PostgreSQL installation that may already occupy 5432.
POSTGRES_USER=creatoros
POSTGRES_PASSWORD=creatoros_dev_password
POSTGRES_DB=creatoros
DATABASE_URL=postgresql+psycopg://creatoros:creatoros_dev_password@localhost:5434/creatoros

# Redis
REDIS_URL=redis://localhost:6379/0

# Auth
JWT_SECRET=change-me-to-a-long-random-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# API
CORS_ORIGINS=http://localhost:3000
API_V1_PREFIX=/api/v1

# Frontend (also copy into frontend/.env.local)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
