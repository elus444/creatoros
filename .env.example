# Database
# Docker Compose maps Postgres to host port 5434 (not 5432) to avoid conflicts
# with a native/system PostgreSQL installation that may already occupy 5432.
POSTGRES_USER=creatoros
POSTGRES_PASSWORD=creatoros_dev_password
POSTGRES_DB=creatoros
DATABASE_URL=postgresql+psycopg://creatoros:creatoros_dev_password@localhost:5434/creatoros

# Redis
REDIS_URL=redis://localhost:6379/0

# Auth
JWT_SECRET=change-me-to-a-long-random-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# API
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000
API_V1_PREFIX=/api/v1

# Frontend (also copy into frontend/.env.local)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Rate limiting (M7) — Redis fixed-window counters for expensive routes
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_WINDOW_SECONDS=60
# RATE_LIMIT_USER_MAX=20
# RATE_LIMIT_AUTOMATION_MAX=60
#
# Set this to the number of reverse proxies in front of the app (e.g. 1 for
# a single nginx/load balancer) ONLY if that proxy strips/overwrites any
# client-supplied X-Forwarded-For before appending its own hop. Leave at 0
# (default) to always rate-limit by the real TCP peer address, which is
# safe with no proxy config assumptions.
# TRUSTED_PROXY_HOPS=0
# MAX_LIST_ITEMS=200

# Trend collectors (M2)
# Google Trends uses the public daily-trends RSS feed — no credentials
# needed. Set the 2-letter region code for trending searches (default US).
GOOGLE_TRENDS_GEO=US
# YouTube requires a real API key (YouTube Data API v3, console.cloud.google.com).
# Leave empty to skip YouTube collection.
YOUTUBE_API_KEY=

# LLM (M3) — Google Gemini, via the generateContent REST API.
# Get a free key at https://aistudio.google.com/apikey
# Leave empty to disable content generation (fails clearly, never fakes output).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# Automation (M5) — shared secret for n8n -> FastAPI webhooks.
# Send as header X-Automation-Secret. Leave empty to disable automation APIs (503).
# Never commit a real secret.
N8N_WEBHOOK_SECRET=
# Optional: how long Redis keeps job + idempotency records (seconds, default 24h)
# AUTOMATION_JOB_TTL_SECONDS=86400
# Optional: a job stuck in "running" longer than this is auto-reaped to
# "failed" on next read (seconds, default 30 min) — covers a worker crash
# or backend restart mid-job so n8n never polls a job that will never move.
# AUTOMATION_JOB_STALE_SECONDS=1800
# Optional: n8n webhook URL to notify on job completion/failure (trend
# collect, content generate, publish, coach). Sent as a signed POST with
# header X-Automation-Secret set to N8N_WEBHOOK_SECRET above, so n8n can
# verify the call came from this backend. Leave unset to disable — n8n can
# still poll GET /automation/jobs/{id} instead.
# N8N_NOTIFY_WEBHOOK_URL=https://your-n8n-host/webhook/creatoros-events

# Video generation — short-form YouTube Shorts only (9:16).
# Provider "none" fails clearly (never invents videos).
# JSON2Video (free tier, narrated Shorts with Azure TTS audio):
#   VIDEO_GENERATION_PROVIDER=json2video
#   JSON2VIDEO_API_KEY=...   (backend only — never expose to frontend)
# Replicate (silent diffusion; paid credits): VIDEO_GENERATION_PROVIDER=replicate
VIDEO_GENERATION_PROVIDER=json2video
JSON2VIDEO_API_KEY=
JSON2VIDEO_VOICE=en-US-AnaNeural
JSON2VIDEO_VIDEO_MODEL=seedance-v1.5-pro
VIDEO_CONTENT_STYLE=kids
REPLICATE_API_TOKEN=
VIDEO_GENERATION_API_KEY=
VIDEO_GENERATION_API_URL=

# Object/file storage for generated videos (not PostgreSQL).
# local = filesystem under STORAGE_LOCAL_PATH served via STORAGE_PUBLIC_BASE_URL
# supabase = private `videos` bucket; Postgres stores only storage_key + URL metadata
STORAGE_BACKEND=supabase
STORAGE_LOCAL_PATH=storage
STORAGE_PUBLIC_BASE_URL=http://127.0.0.1:8000/media
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Backend secret/service key (sb_secret_... or legacy service_role). Required for
# private uploads + bucket create. Do NOT put the publishable key here.
SUPABASE_SECRET_KEY=
SUPABASE_PUBLISHABLE_KEY=

# YouTube OAuth publishing (YouTube-only). Backend environment secrets — never
# put these in NEXT_PUBLIC_* or the frontend. Refresh tokens stay encrypted
# on the server and are never returned to the browser.
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
YOUTUBE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/youtube/oauth/callback
FRONTEND_URL=http://localhost:3000
